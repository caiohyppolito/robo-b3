<?xml version="1.0" encoding="utf-8"?>
<!-- Isola o repositório dos feeds configurados na máquina (ex.: feeds privados
     que exigem autenticação). Só o nuget.org é usado aqui. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
